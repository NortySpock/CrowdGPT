# Copy to .env and edit. .env is ignored by git and .dockerignore.

# --- account (optional) ---
# Leave all three empty to train anonymously (CROWDGPT_ANON=1).
# CROWDGPT_USER=your_username
# CROWDGPT_PASSWORD=your_password
# Or use an existing token instead of username/password:
# CROWDGPT_TOKEN=

# --- runtime ---
# DNS server used inside the container (your LAN resolver).
# CROWDGPT_DNS=192.168.21.6
# CROWDGPT_ANON=1
# CROWDGPT_BACKEND=cuda
# CROWDGPT_VRAM_GB=8
# CROWDGPT_ROUNDS=0
# CROWDGPT_ENGRAM=1
# CROWDGPT_NO_UPDATE=0
# CROWDGPT_NO_TOKENIZER=1   # 0 loads the tokenizer with trust_remote_code=True
# CROWDGPT_DEBUG=0
# CROWDGPT_SERVER=https://server.crowdgpt.net

# Set to 1 for one start to copy the image's client.py/client.html into the
# /app volume (useful after rebuilding the image). Checkpoints are kept.
# CROWDGPT_SYNC_CODE=0

# --- base image ---
# Default is CUDA 12.4 / PyTorch 2.6. For Blackwell / RTX 50-series:
# PYTORCH_IMAGE=pytorch/pytorch:2.7.0-cuda12.8-cudnn9-runtime
